{
  "name": "@forge-kits/telescope",
  "version": "0.1.2",
  "description": "Nuxt module bridge for forge-kits (FastAPI)",
  "type": "module",
  "exports": {
    ".": "./dist/module.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "nuxt generate --rootDir src/client && nuxt-module-build build && node scripts/postbuild.mjs",
    "dev": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt dev playground",
    "dev:client": "nuxt dev --rootDir src/client",
    "prepare": "nuxt-module-build prepare",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@forge-kits/nuxt": "^0.1.1",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.6",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nuxt": "^4.0.0",
    "oxc-parser": "latest",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "nuxt": "^3.17.0 || ^4.0.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
